# ==============================================================================
# DG NEXUS — Environment Configuration Contract (Milestone M0)
# Copy this file to `.env.local` for local development. Never commit `.env.local`.
# ==============================================================================

# Public application environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Canonical site URL (used for auth callbacks, SEO metadata, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project (Public — safe for browser, protected by PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_ and NEVER import in client code)
# Required only for server-side admin/migration tasks where explicitly audited
SUPABASE_SERVICE_ROLE_KEY=
